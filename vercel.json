{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "devCommand": "pnpm --filter @evomypet/web dev",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/app.ts": { "maxDuration": 30, "supportsCancellation": true },
    "api/integrations.ts": {
      "maxDuration": 30,
      "supportsCancellation": true
    },
    "api/jobs.ts": { "maxDuration": 300 }
  },
  "headers": [
    {
      "source": "/maintenance.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co; font-src 'self' data:; connect-src 'self' https://rest.ably.io https://realtime.ably.io wss://realtime.ably.io https://main.realtime.ably.net wss://main.realtime.ably.net https://*.ably-realtime.com wss://*.ably-realtime.com; worker-src 'self' blob:"
        }
      ]
    }
  ],
  "crons": [
    { "path": "/api/jobs/reconcile-payments", "schedule": "*/5 * * * *" },
    { "path": "/api/jobs/cleanup-idempotency", "schedule": "35 2 * * *" },
    { "path": "/api/jobs/monitor-invariants", "schedule": "*/5 * * * *" },
    { "path": "/api/jobs/cleanup-catalog-assets", "schedule": "15 3 * * *" }
  ],
  "rewrites": [
    {
      "source": "/api/telegram/webhook",
      "destination": "/api/integrations?__route=telegram/webhook"
    },
    {
      "source": "/api/integrations/battle-share",
      "destination": "/api/integrations?__route=integrations/battle-share"
    },
    {
      "source": "/api/integrations/battle-outbox",
      "destination": "/api/integrations?__route=integrations/battle-outbox"
    },
    {
      "source": "/api/jobs/:path*",
      "destination": "/api/jobs?__route=jobs/:path*"
    },
    { "source": "/api/:path*", "destination": "/api/app?__route=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
